table feature_importance
	lineageTag: 3f938c74-2623-4bcf-9987-02df1ef20c73

	/// share of the model's splitting power from a feature (sums to 100 per model)
	measure 'Importance %' = SUM ( feature_importance[importance_pct] )
		formatString: 0.0
		lineageTag: 3190ff28-1b73-49cb-bde7-1fb1b9e97d68

	column model
		dataType: string
		isHidden
		lineageTag: c446a92a-1c42-4cfe-9a54-3bcac959afea
		summarizeBy: none
		sourceColumn: model

		annotation SummarizationSetBy = Automatic

	column rank
		dataType: int64
		lineageTag: d1638690-2126-4647-8959-6a3fe67594cf
		summarizeBy: none
		sourceColumn: rank

		annotation SummarizationSetBy = Automatic

	column feature
		dataType: string
		lineageTag: f57bc21f-6fb8-4f0a-8a00-2989987ebd4d
		summarizeBy: none
		sourceColumn: feature

		annotation SummarizationSetBy = Automatic

	column importance_pct
		dataType: double
		lineageTag: 1238424d-f54b-4dd2-99dc-e4bea2b49982
		summarizeBy: sum
		sourceColumn: importance_pct

		annotation SummarizationSetBy = Automatic

	column feature_group
		dataType: string
		lineageTag: aed1bfc1-1834-4a6a-91d9-30db93f4dc62
		summarizeBy: none
		sourceColumn: feature_group

		annotation SummarizationSetBy = Automatic

	partition feature_importance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "feature_importance.csv"),[Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"model", type text}, {"rank", Int64.Type}, {"feature", type text}, {"importance_pct", type number}, {"feature_group", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
