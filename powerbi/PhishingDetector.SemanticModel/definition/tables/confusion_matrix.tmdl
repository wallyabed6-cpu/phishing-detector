table confusion_matrix
	lineageTag: 8b06aaa1-e3ec-4edf-b43e-e0dd28a649c5

	/// URL count for an actual / predicted pair
	measure 'Confusion URLs' = SUM ( confusion_matrix[urls] )
		formatString: #,0
		lineageTag: c8d2f222-70dc-4754-9792-af630c7b6e86

	column model
		dataType: string
		isHidden
		lineageTag: ab4de3e4-45b9-41db-97f8-4835796f8f5a
		summarizeBy: none
		sourceColumn: model

		annotation SummarizationSetBy = Automatic

	column actual
		dataType: string
		lineageTag: 12bebf09-1c7c-461d-80cf-8a86eff27964
		summarizeBy: none
		sourceColumn: actual

		annotation SummarizationSetBy = Automatic

	column predicted
		dataType: string
		lineageTag: 8e1e9077-e32e-4fcd-8076-c6b418be2ebb
		summarizeBy: none
		sourceColumn: predicted

		annotation SummarizationSetBy = Automatic

	column urls
		dataType: int64
		lineageTag: 5ff23ee8-1a42-4b40-8e49-ce6bf20a749a
		summarizeBy: sum
		sourceColumn: urls

		annotation SummarizationSetBy = Automatic

	partition confusion_matrix = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "confusion_matrix.csv"),[Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"model", type text}, {"actual", type text}, {"predicted", type text}, {"urls", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
