table model_metrics
	lineageTag: d3ca4227-e8a6-48e6-9ab2-26435ab1f747

	/// share of test URLs classified correctly
	measure 'Accuracy' = AVERAGE ( model_metrics[accuracy_raw] )
		formatString: 0.000%
		lineageTag: d0dadbf5-874c-4fbc-9939-e5c47ddec45f

	/// of all phishing URLs, the share that was caught
	measure 'Recall' = AVERAGE ( model_metrics[recall_raw] )
		formatString: 0.00%
		lineageTag: bbd2c045-6c88-4c57-afb0-068f3416f0a3

	/// of URLs flagged as phishing, the share that really were
	measure 'Precision' = AVERAGE ( model_metrics[precision_raw] )
		formatString: 0.00%
		lineageTag: ce397018-ae44-448b-a147-9f1109d1d23b

	/// balance of precision and recall
	measure 'F1 Score' = AVERAGE ( model_metrics[f1] )
		formatString: 0.0000
		lineageTag: b52061be-d8ed-4083-a803-2f051e1328b9

	/// phishing URLs that got through (false negatives)
	measure 'Missed Phishing' = SUM ( model_metrics[false_negatives] )
		formatString: #,0
		lineageTag: 3232d4b8-c995-4004-b07d-196a4717ebb6

	/// legitimate URLs wrongly flagged (false positives)
	measure 'False Alarms' = SUM ( model_metrics[false_positives] )
		formatString: #,0
		lineageTag: 8f509605-b6ce-4e8d-8389-cec76fdc7510

	/// size of the held-out test set
	measure 'Test URLs' = MAX ( model_metrics[test_urls] )
		formatString: #,0
		lineageTag: 7d3a4411-6548-43ee-9bef-325cc0eae4c1

	/// phishing URLs in the test set
	measure 'Phishing in Test' = MAXX ( model_metrics, model_metrics[true_positives] + model_metrics[false_negatives] )
		formatString: #,0
		lineageTag: e0e5f6a5-2b08-4327-9107-9a1b6fac14e2

	column model
		dataType: string
		isHidden
		lineageTag: ac7f3d9f-ff59-4611-ab7e-c9c9d935ffbc
		summarizeBy: none
		sourceColumn: model

		annotation SummarizationSetBy = Automatic

	column test_urls
		dataType: int64
		lineageTag: 52e7e152-bd5c-444c-9832-4a713bda2008
		summarizeBy: none
		sourceColumn: test_urls

		annotation SummarizationSetBy = Automatic

	column accuracy_raw
		dataType: double
		isHidden
		formatString: 0.00%
		lineageTag: 613ddbf7-b715-4bcd-b965-69b3acda6d14
		summarizeBy: none
		sourceColumn: accuracy

		annotation SummarizationSetBy = Automatic

	column precision_raw
		dataType: double
		isHidden
		formatString: 0.00%
		lineageTag: f69e0525-5624-4097-8cc0-9212361a86b4
		summarizeBy: none
		sourceColumn: precision

		annotation SummarizationSetBy = Automatic

	column recall_raw
		dataType: double
		isHidden
		formatString: 0.00%
		lineageTag: d867318e-2c8e-452c-af2c-c0bdcd76834b
		summarizeBy: none
		sourceColumn: recall

		annotation SummarizationSetBy = Automatic

	column f1
