table feature_importance
	lineageTag: a16a6400-b447-4cf1-8a4d-256467bd64a0

	/// share of the model's splitting power from a feature (sums to 100 per model)
	measure 'Importance %' = SUM ( feature_importance[importance_pct] )
		formatString: 0.0
		lineageTag: cd8a1c6b-9a09-4f93-9b41-c2f949837be7

	column model
		dataType: string
		isHidden
		lineageTag: d116435a-8305-4f79-8259-847e61b4312d
		summarizeBy: none
		sourceColumn: model

		annotation SummarizationSetBy = Automatic

	column rank
		dataType: int64
		lineageTag: 52447b4a-cce7-4481-b419-15d38f409c23
		summarizeBy: none
		sourceColumn: rank

		annotation SummarizationSetBy = Automatic

	column feature
		dataType: string
		lineageTag: a62c8302-f338-46ae-9f53-db3460f90cb0
		summarizeBy: none
		sourceColumn: feature

		annotation SummarizationSetBy = Automatic

	column importance_pct
		dataType: double
		lineageTag: 37fc2984-aed1-43c7-bfda-66c0396d4b69
		summarizeBy: sum
		sourceColumn: importance_pct

		annotation SummarizationSetBy = Automatic

	column feature_group
		dataType: string
		lineageTag: d26bc481-6aab-4c3a-8bfd-af94e43aeebb
		summarizeBy: none
		sourceColumn: feature_group

		annotation SummarizationSetBy = Automatic

	partition feature_importance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "feature_importance.csv"),[Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"model", type text}, {"rank", Int64.Type}, {"feature", type text}, {"importance_pct", type number}, {"feature_group", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
