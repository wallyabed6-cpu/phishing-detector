		isHidden
		formatString: 0.00%
		lineageTag: e6b63ab7-331a-4419-8892-2dcf1ee7408c
		summarizeBy: none
		sourceColumn: precision

		annotation SummarizationSetBy = Automatic

	column recall_raw
		dataType: double
		isHidden
		formatString: 0.00%
		lineageTag: dffd40c3-ce1c-4b03-9f0f-3bc46c3a7935
