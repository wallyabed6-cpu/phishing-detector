table score_distribution
	lineageTag: db5b10fb-c4aa-4e0f-b846-efc92e2fccff

	/// test URLs whose risk score falls in the band
	measure 'URLs in Band' = SUM ( score_distribution[urls] )
		formatString: #,0
		lineageTag: 33a5d570-e338-4acd-8964-a5d7447a8098

	column model
		dataType: string
		isHidden
		lineageTag: fc85994e-fda4-4044-be25-6347bde28e2d
		summarizeBy: none
		sourceColumn: model

		annotation SummarizationSetBy = Automatic

	column true_class
		dataType: string
		lineageTag: 2f215c1a-785b-4440-9e2a-48ba8d0350ec
		summarizeBy: none
		sourceColumn: true_class

		annotation SummarizationSetBy = Automatic

	column band_order
		dataType: int64
		isHidden
		lineageTag: 5933d4dd-116c-4b50-8c15-e8d4912550b3
		summarizeBy: none
		sourceColumn: band_order

		annotation SummarizationSetBy = Automatic

	column risk_band
		dataType: string
		lineageTag: ef426f58-e1ea-4aa8-9aa0-40f8a6013e1f
		summarizeBy: none
		sourceColumn: risk_band
		sortByColumn: band_order

		annotation SummarizationSetBy = Automatic

	column urls
		dataType: int64
		lineageTag: 13ac064f-18a0-4d44-a680-440ee78462f0
		summarizeBy: sum
		sourceColumn: urls

		annotation SummarizationSetBy = Automatic

	partition score_distribution = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "score_distribution.csv"),[Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"model", type text}, {"true_class", type text}, {"band_order", Int64.Type}, {"risk_band", type text}, {"urls", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
