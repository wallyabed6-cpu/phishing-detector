table model_metrics
	lineageTag: 7f708a66-5e37-43e7-9fec-a5ee7c90332f

	/// share of test URLs classified correctly
	measure 'Accuracy' = AVERAGE ( model_metrics[accuracy_raw] )
		formatString: 0.000%
		lineageTag: ecbb5744-38c3-4d17-b6a3-57b212187a86

	/// of all phishing URLs, the share that was caught
	measure 'Recall' = AVERAGE ( model_metrics[recall_raw] )
		formatString: 0.000%
		lineageTag: d5fc538a-66e2-4178-bbbe-dd9f9d76bdc5

	/// of URLs flagged as phishing, the share that really were
	measure 'Precision' = AVERAGE ( model_metrics[precision_raw] )
		formatString: 0.000%
		lineageTag: 801d2885-e196-4f50-94a7-706756674950

	/// balance of precision and recall
	measure 'F1 Score' = AVERAGE ( model_metrics[f1] )
		formatString: 0.0000
		lineageTag: 09f8f8b3-6f86-47dd-9a91-522604e5f0a0

	/// phishing URLs that got through (false negatives)
	measure 'Missed Phishing' = SUM ( model_metrics[false_negatives] )
		formatString: #,0
		lineageTag: 48c09973-f716-4024-bdea-435d4e250f16

	/// legitimate URLs wrongly flagged (false positives)
	measure 'False Alarms' = SUM ( model_metrics[false_positives] )
		formatString: #,0
		lineageTag: 8797249a-32be-4e43-ae48-0e76503e61f6

	/// size of the held-out test set
	measure 'Test URLs' = MAX ( model_metrics[test_urls] )
		formatString: #,0
		lineageTag: acdbc768-5ac8-4a85-a035-cc74b2f2fc49

	/// phishing URLs in the test set
	measure 'Phishing in Test' = MAXX ( model_metrics, model_metrics[true_positives] + model_metrics[false_negatives] )
		formatString: #,0
		lineageTag: 8cd82dac-31f9-4153-9a23-ac7159eda86f

	column model
		dataType: string
		isHidden
		lineageTag: b29d9932-8999-47fa-9659-e7b33ba37254
		summarizeBy: none
		sourceColumn: model

		annotation SummarizationSetBy = Automatic

	column test_urls
		dataType: int64
		lineageTag: 42341af4-ae6d-47fe-b97c-3eb3524a13cc
		summarizeBy: none
		sourceColumn: test_urls

		annotation SummarizationSetBy = Automatic

	column accuracy_raw
		dataType: double
		isHidden
		formatString: 0.00%
		lineageTag: 9c342be7-700e-4927-b45e-7939bb722401
		summarizeBy: none
		sourceColumn: accuracy

		annotation SummarizationSetBy = Automatic

	column precision_raw
