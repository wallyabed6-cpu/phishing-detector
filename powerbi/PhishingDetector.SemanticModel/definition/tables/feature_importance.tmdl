table feature_importance
	lineageTag: e67500c1-b490-43a4-af8f-9f455257dde5

	/// share of the model's splitting power from a feature (sums to 100 per model)
	measure 'Importance %' = SUM ( feature_importance[importance_pct] )
		formatString: 0.0
		lineageTag: 9b71691f-d9c0-4d5b-8be9-c8f1fdbc63b2

	column model
		dataType: string
		isHidden
		lineageTag: 28f5d5c9-91f5-4e64-9677-f9727da1b6dd
		summarizeBy: none
		sourceColumn: model

		annotation SummarizationSetBy = Automatic

	column rank
		dataType: int64
		lineageTag: b7282c1c-acce-4f8d-b16d-5184befc1ea8
		summarizeBy: none
		sourceColumn: rank

		annotation SummarizationSetBy = Automatic

	column feature
		dataType: string
		lineageTag: df232e3d-5e59-4b23-b099-dc4cb0432955
		summarizeBy: none
		sourceColumn: feature

		annotation SummarizationSetBy = Automatic

	column importance_pct
		dataType: double
		lineageTag: 3f060e6b-3752-48bf-8685-4b55f037a4ca
		summarizeBy: sum
		sourceColumn: importance_pct

		annotation SummarizationSetBy = Automatic

	column feature_group
		dataType: string
		lineageTag: fe5dc747-3330-423e-b011-10c42b5a059c
		summarizeBy: none
		sourceColumn: feature_group

		annotation SummarizationSetBy = Automatic

	partition feature_importance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "feature_importance.csv"),[Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"model", type text}, {"rank", Int64.Type}, {"feature", type text}, {"importance_pct", type number}, {"feature_group", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
