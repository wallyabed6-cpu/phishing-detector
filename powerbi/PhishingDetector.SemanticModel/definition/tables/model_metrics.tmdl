table model_metrics
	lineageTag: 78427cc7-cc4f-480b-89a9-fa9b3800bfe1

	/// share of test URLs classified correctly
	measure 'Accuracy' = AVERAGE ( model_metrics[accuracy] )
		formatString: 0.000%
		lineageTag: f0b88b86-c1f3-4911-8721-aedfff0bd48b

	/// of all phishing URLs, the share that was caught
	measure 'Recall' = AVERAGE ( model_metrics[recall] )
		formatString: 0.00%
		lineageTag: 4e6f216e-3ebe-4280-95e1-c3a49dd7d365

	/// of URLs flagged as phishing, the share that really were
	measure 'Precision' = AVERAGE ( model_metrics[precision] )
		formatString: 0.00%
		lineageTag: b34b780d-6bd0-4a9a-ad4e-ac207310dfe9

	/// balance of precision and recall
	measure 'F1 Score' = AVERAGE ( model_metrics[f1] )
		formatString: 0.0000
		lineageTag: 11d5af45-e4aa-4fe4-b4fa-264b5280f3c2

	/// phishing URLs that got through (false negatives)
	measure 'Missed Phishing' = SUM ( model_metrics[false_negatives] )
		formatString: #,0
		lineageTag: 8f4ae6b2-83c8-46b3-b396-6f985957b797

	/// legitimate URLs wrongly flagged (false positives)
	measure 'False Alarms' = SUM ( model_metrics[false_positives] )
		formatString: #,0
		lineageTag: 401a51f4-3fe4-46ae-887d-2e63f9442867

	/// size of the held-out test set
	measure 'Test URLs' = MAX ( model_metrics[test_urls] )
		formatString: #,0
		lineageTag: a9bdf88b-dc06-4c69-9035-5c071ffd8fb0

	/// phishing URLs in the test set
	measure 'Phishing in Test' = MAXX ( model_metrics, model_metrics[true_positives] + model_metrics[false_negatives] )
		formatString: #,0
		lineageTag: 91ae0225-f84c-414a-ac8c-e16f0a1805e2

	column model
		dataType: string
		isHidden
		lineageTag: 9cf06fdd-7c05-42a3-9c74-b90c67921d06
		summarizeBy: none
		sourceColumn: model

		annotation SummarizationSetBy = Automatic

	column test_urls
		dataType: int64
		lineageTag: 1b8d6bbb-bb1c-4446-8f22-84d2eeeba6bc
		summarizeBy: none
		sourceColumn: test_urls

		annotation SummarizationSetBy = Automatic

	column accuracy
		dataType: double
		formatString: 0.00%
		lineageTag: 4ada8d9e-fe45-4b87-bbf8-586a022ebd90
		summarizeBy: none
		sourceColumn: accuracy

		annotation SummarizationSetBy = Automatic

	column precision
		dataType: double
		formatString: 0.00%
		lineageTag: 1d5712d4-bcb2-4262-be08-c7dbae70e1ed
		summarizeBy: none
		sourceColumn: precision

		annotation SummarizationSetBy = Automatic

	column recall
		dataType: double
		formatString: 0.00%
		lineageTag: 51dd49cd-f462-44c2-bb7c-4632c2e28eed
		summarizeBy: none
		sourceColumn: recall

		annotation SummarizationSetBy = Automatic

	column f1
		dataType: double
		lineageTag: bbc31787-14a3-4dc0-9f05-366dddf7cddc
		summarizeBy: none
		sourceColumn: f1

		annotation SummarizationSetBy = Automatic

	column true_positives
		dataType: int64
		lineageTag: 9799c11c-6b91-4e76-91e2-dba2dbfd1b57
		summarizeBy: none
		sourceColumn: true_positives

		annotation SummarizationSetBy = Automatic

